# ---- Semble --------------------------------------------------------------
# "mock" runs the portal against in-memory demo data (default, safe to present).
# "graphql" talks to the practice's Semble tenant — server-side only.
SEMBLE_ADAPTER=mock
# Production: https://open.semble.io/graphql · BBMI sandbox practice: https://open.sandbox.semble.io/graphql
SEMBLE_GRAPHQL_URL=https://open.semble.io/graphql
# Optional. Defaults to the practice's first location.
SEMBLE_LOCATION_ID=
# Practice-scoped integration token. NEVER prefix with NEXT_PUBLIC_.
SEMBLE_API_TOKEN=
# Practice timezone — Semble returns naive local wall-clock tagged as UTC.
SEMBLE_PRACTICE_TZ=Europe/Dublin

# ---- Portal --------------------------------------------------------------
# Signs the session cookie. Required (16+ characters) when SEMBLE_ADAPTER=graphql.
# Mock mode: any demo email works and the password is ignored.
PORTAL_SESSION_SECRET=change-me-in-real-deployments
# Semble mode only: who may sign in while there is no real authentication (comma-separated).
# Each must be the email on a Semble patient record.
PORTAL_ALLOWED_EMAILS=
# Stripe stays the biller for memberships/programmes (Semble Pay is per-invoice only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
