# ---- Semble --------------------------------------------------------------
# "mock" runs the portal against in-memory demo data (default, safe to present).
# "graphql" talks to the practice's Semble tenant — server-side only.
SEMBLE_ADAPTER=mock
# Production: https://open.semble.io/graphql · BBMI sandbox practice: https://open.sandbox.semble.io/graphql
# The adapter refuses a non-sandbox URL unless PORTAL_ALLOW_PRODUCTION=1 — leave that unset until real sign-in exists.
SEMBLE_GRAPHQL_URL=https://open.sandbox.semble.io/graphql
PORTAL_ALLOW_PRODUCTION=
# Optional. By default each appointment type is booked into the rooms whose Semble "Services provided" include it.
SEMBLE_LOCATION_ID=
# Practice-scoped integration token. NEVER prefix with NEXT_PUBLIC_.
SEMBLE_API_TOKEN=
# Practice timezone — Semble returns naive local wall-clock tagged as UTC.
SEMBLE_PRACTICE_TZ=Europe/Dublin

# ---- Portal --------------------------------------------------------------
# Signs the session cookie. Semble mode requires a random 32+ character value: `openssl rand -hex 32`.
# Mock mode: any demo email works and the password is ignored.
PORTAL_SESSION_SECRET=
# Semble mode only: who may sign in while there is no real authentication (comma-separated).
# Each must be the email on a Semble patient record.
PORTAL_ALLOWED_EMAILS=
# Sandbox demos only: "1" lists the allowed emails on the login page as one-click sign-in buttons.
PORTAL_DEMO_QUICK_LOGIN=
# Stripe stays the biller for memberships/programmes (Semble Pay is per-invoice only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Beyond BMI backend + sign-in ----------------------------------------
# "cognito" = real patient logins (the existing Cognito pool) and patient data from the Beyond BMI backend;
# requires SEMBLE_ADAPTER=graphql. "demo" (default) = mock personas / the Semble allow-list above.
PORTAL_AUTH=demo
COGNITO_REGION=eu-west-1
# QA: eu-west-1_pcB1yvtaf / 5s3aesglete1rdq22vfeu3qfj5 (public web client: SRP + refresh, no secret)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# QA: https://backend.qa.beyondbmi.ie/api/v1
BBMI_API_URL=
# Intake and follow-up questionnaires are Beyond BMI's Tally forms. QA: https://survey.qa.beyondbmi.ie/ and "surv".
BBMI_TALLY_URL=
BBMI_E89_SURVEY_PATH=
# Optional: tell Ongoing Care plans apart from the legacy €150 membership (Stripe price ids).
BBMI_PRICE_ONGOING_75=
BBMI_PRICE_ONGOING_150=
# Doctor bookings need a weight from the last N days (Beyond BMI default 45).
PORTAL_WEIGHT_STALE_DAYS=45
